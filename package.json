{
  "name": "urth-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images:mobile": "node scripts/make-mobile-images.mjs",
    "tiles:political": "node scripts/make-tiles.mjs public/blank-political.png public/tiles/political --min -2 --max 0",
    "tiles:cities": "node scripts/make-tiles.mjs public/cities.png public/tiles/cities --min -2 --max 0 --format png",
    "tiles:subnational": "node scripts/make-tiles.mjs public/subnational.png public/tiles/subnational --min -2 --max 0 --format png",
    "tiles:all": "npm run tiles:political && npm run tiles:cities && npm run tiles:subnational"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.11",
    "vite": "^5.4.19"
  }
}
